{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "食品新标迁移与批次处置领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "STANDARD_REGISTERED",
        "STANDARD_SUPERSEDED",
        "PRODUCT_REGISTERED",
        "ASSOCIATION_SUGGESTED",
        "ASSOCIATION_CONFIRMED",
        "ASSOCIATION_REJECTED",
        "LOT_RECEIVED",
        "LOT_FAILED",
        "BATCH_REGISTERED",
        "EVIDENCE_LINKED",
        "PROCESS_EVIDENCE_CAPTURED",
        "BATCH_REVIEWED",
        "BATCH_FROZEN",
        "BATCH_UNFROZEN",
        "BATCH_SHIPPED",
        "DISPOSITION_CHANGED",
        "REPORT_ACCEPTED",
        "REPORT_DUPLICATE",
        "REPORT_CONFLICTED",
        "RECALL_DECLARED",
        "RECALL_NARROWING_REQUESTED",
        "RECALL_NARROWED",
        "RECALL_NARROWING_REJECTED",
        "ACTION_SCHEDULED",
        "ACTION_STARTED",
        "ACTION_COMPLETED",
        "ACTION_FAILED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "standard_revision",
        "product",
        "material_lot",
        "product_batch",
        "compliance_decision",
        "lab_report",
        "recall",
        "workflow_action"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
